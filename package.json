{
  "name": "modular-typescript-monolith-api",
  "version": "0.0.1",
  "description": "",
  "author": "johnpgr",
  "type": "module",
  "main": "src/Main.ts",
  "engines": {
    "node": ">=26.13.1"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/Main.ts",
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=.env src/Main.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "dependency-cruiser": "^18.8.0",
    "drizzle-kit": "^1.0.0-rc.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.1.0-beta"
  },
  "dependencies": {
    "@effect/ai-openai": "^4.1.5",
    "@effect/platform-node": "^4.1.5",
    "@effect/sql-pg": "^4.1.5",
    "@sentry/effect": "^11.16.0",
    "drizzle-orm": "^1.0.0-rc.6",
    "effect": "^4.1.5",
    "pdfkit": "^0.21.0"
  }
}
